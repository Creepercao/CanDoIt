ARG MIRROR=docker.m.daocloud.io/library/

FROM ${MIRROR}python:3.12-slim

WORKDIR /app

# System deps (curl for healthcheck, CJK fonts for matplotlib charts,
# chromium for Playwright-based HTML -> PPTX visual export)
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends --fix-missing \
    chromium \
    curl \
    fonts-unifont \
    fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Python deps (use Tsinghua mirror for China)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    --trusted-host pypi.tuna.tsinghua.edu.cn \
    -r requirements.txt

# App code
COPY backend/ ./backend/
COPY providers.yaml ./

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
